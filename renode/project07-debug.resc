:name: FSAE Training Project 07 Debug
using sysbus
mach create "FSAE_Project07_Debug"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl
machine LoadPlatformDescription @renode/project02-button-exti.repl
sysbus LoadELF @build/07/project07.elf
machine StartGdbServer 3333
cpu PerformanceInMips 125
showAnalyzer sysbus.uart4
